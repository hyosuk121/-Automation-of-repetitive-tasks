# Supabase project settings. Never commit actual credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Use the Supabase session pooler connection for the worker/migrations.
# Vercel may use the transaction pooler connection. TLS verification remains enabled.
DATABASE_URL=
# Optional trusted CA file if required by your database provider.
DATABASE_CA_FILE=
ADMIN_EMAILS=
APP_ORIGIN=http://localhost:4173
PORT=4173
CRON_SECRET=
# Minimum successful collection interval and maximum active competitors per administrator.
COLLECTION_INTERVAL_SECONDS=300
MAX_COMPETITORS=100
# Worker daily collection time in Asia/Seoul, 0-23.
SCHEDULE_HOUR_KST=9
