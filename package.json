{
  "name": "automation-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "start": "node --env-file-if-exists=.env server.js",
    "build": "vite build",
    "worker": "node --env-file-if-exists=.env scripts/worker.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "import:json": "node --env-file-if-exists=.env scripts/import.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-test.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@supabase/supabase-js": "^2.99.0",
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "google-play-scraper": "^10.1.2",
    "lucide": "^0.468.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "playwright-core": "^1.58.2",
    "vite": "^6.4.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
